# Copy to .env and adjust. Never commit .env with real secrets.
DJANGO_SECRET_KEY=change-me-in-production
# Local dev needs True (production default is False, which enables HTTPS-only).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Production only, comma-separated, e.g. https://shopbill.onrender.com
CSRF_TRUSTED_ORIGINS=
# Optional: set to use PostgreSQL instead of SQLite, e.g.
# DATABASE_URL=postgres://user:password@localhost:5432/shopbill
DATABASE_URL=
